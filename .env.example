DATABASE_URL=postgresql://meal_planner:meal_planner@localhost:5432/meal_planner
DATABASE_DIRECT_URL=postgresql://meal_planner:meal_planner@localhost:5432/meal_planner
DATABASE_URL_UNPOOLED=postgresql://meal_planner:meal_planner@localhost:5432/meal_planner
# Structured recipe drafts use Google Gemini through Vercel AI Gateway. Production
# authenticates with project OIDC, so no provider API key is required by default.
# Optional Google Vertex AI BYOK is configured in the Vercel AI Gateway dashboard,
# not in this file. BYOK still requires AI Gateway credits to be enabled.
AI_RECIPE_MODEL=google/gemini-3.7-flash
SESSION_COOKIE_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:5173

# Seed configuration. Prefer strict member profiles for real households.
HOUSEHOLD_NAME=Our household
HOUSEHOLD_TIMEZONE=America/Chicago
HOUSEHOLD_MEMBER_PROFILES_JSON=[{"seedKey":"adult-one","displayName":"Adult One","email":"adult-one@example.com","memberType":"adult","appetiteMultiplier":"1.00"},{"seedKey":"adult-two","displayName":"Adult Two","email":"adult-two@example.com","memberType":"adult","appetiteMultiplier":"1.00"},{"seedKey":"adult-three","displayName":"Adult Three","email":null,"memberType":"adult","appetiteMultiplier":"1.00"},{"seedKey":"teen","displayName":"Teen","email":null,"memberType":"child","appetiteMultiplier":"1.40"},{"seedKey":"young-child","displayName":"Young Child","email":null,"memberType":"child","appetiteMultiplier":"0.50"}]
# Legacy fallback used only when HOUSEHOLD_MEMBER_PROFILES_JSON is blank.
HOUSEHOLD_ADULT_EMAILS=adult-one@example.com,adult-two@example.com
HOUSEHOLD_SEED_DRY_RUN=false

# Development exposes a safe preview link on the sign-in page.
# Production requires smtp.
MAGIC_LINK_DELIVERY=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Vercel's Resend integration supplies this as an alternative SMTP password.
RESEND_API_KEY=
SMTP_FROM=Done For You Kitchen <meals@example.com>
